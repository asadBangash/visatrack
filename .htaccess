<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Remove /public/ from the browser URL (old bookmarks or bad generated links)
    RewriteCond %{THE_REQUEST} \s/+public/(\S*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L,NE]

    # Static files under /public
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Laravel front controller (REQUEST_URI stays /admin/..., not /public/...)
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>